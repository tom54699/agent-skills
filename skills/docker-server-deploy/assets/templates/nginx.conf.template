# nginx.conf.template — docker-server-deploy template v1
#
# 假設 TLS 憑證已經存在。第一次申請憑證先用 nginx-bootstrap.conf.template，
# 流程見 references/first-certificate.md。
#
# 網域不進 git：在 server 上用 envsubst 產生實際設定，只替換下面列出的變數，
# 避免動到 Nginx 自己的 $host、$remote_addr 等變數：
#
# 只讀需要的值，不要 source 整個 .env（避免把 secrets 載進 shell）：
#
#   env_file=<DEPLOY_ROOT>/shared/.env
#   export DOMAIN="$(sed -n 's/^DOMAIN=//p' "$env_file")"
#   export WEB_PORT="$(sed -n 's/^WEB_PORT=//p' "$env_file")"
#   export API_PORT="$(sed -n 's/^API_PORT=//p' "$env_file")"
#   envsubst '${DOMAIN} ${WEB_PORT} ${API_PORT}' < nginx.conf.template \
#     | sudo tee /etc/nginx/sites-available/<project>.conf > /dev/null
#   sudo ln -sfn /etc/nginx/sites-available/<project>.conf /etc/nginx/sites-enabled/<project>.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# 修改共用的 Nginx 會影響 server 上的其他專案，執行前要先和使用者確認。

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Nginx 1.25.1 以後可改成 `listen 443 ssl;` 加上 `http2 on;`
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    # certbot 的 nginx plugin 會產生這兩個檔案；沒有的話刪掉這兩行
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # 上傳大小上限，依專案調整（Nginx 預設只有 1m）
    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # API 有串流回應（SSE、逐字輸出）時才需要這兩行
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:${WEB_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket（例如前端的開發工具或即時功能）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
