# env.example — docker-server-deploy template v1
#
# 實際檔案放在 server 的 <DEPLOY_ROOT>/shared/.env，權限 600，不進 git。
# repo 只放這份範例（改名為 deploy/.env.example），值一律用假的。
#
#   install -m 600 /dev/null <DEPLOY_ROOT>/shared/.env

# ---- Nginx 設定產生用 ----
DOMAIN=app.example.com
API_PORT=8000
WEB_PORT=3000

# ---- deploy.sh 用 ----
# 外部 health check；設定後部署時會確認這個網址回應成功
HEALTH_URL=https://app.example.com/api/health

# ---- 應用程式 ----
TZ=Asia/Taipei
DATABASE_URL=postgresql://app:<PASSWORD>@shared-postgres:5432/app
